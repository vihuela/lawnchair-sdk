{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launcher-packer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "launcher-packer.rickyyao.cc/*",
      "zone_name": "rickyyao.cc"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "vihuela",
    "GITHUB_REPOSITORY": "lawnchair-sdk",
    "GITHUB_REF": "feature/sdk-15",
    "GITHUB_WORKFLOW": "launcher_sdk_package.yml",
    "GITHUB_PACKAGES_URL": "https://maven.pkg.github.com/vihuela/lawnchair-sdk"
  },
  "secrets": {
    "required": ["GITHUB_USERNAME", "GITHUB_TOKEN"]
  }
}
