{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launcher-packer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  // Keep every invocation for rare resource-limit errors. No application console
  // logs or tracing spans: normally one event/request. Recheck the shared budget
  // before adding logs: Free currently has 200k events/day; from 2026-12-01,
  // logs share a 0.5 GB/day ingestion allowance with other observability data.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "launcher-packer.rickyyao.cc/*",
      "zone_name": "rickyyao.cc"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "vihuela",
    "GITHUB_REPOSITORY": "lawnchair-sdk",
    "GITHUB_REF": "feature/sdk-15",
    "GITHUB_WORKFLOW": "launcher_sdk_package.yml",
    "GITHUB_PACKAGES_URL": "https://maven.pkg.github.com/vihuela/lawnchair-sdk"
  },
  "secrets": {
    "required": ["GITHUB_USERNAME", "GITHUB_TOKEN"]
  }
}
